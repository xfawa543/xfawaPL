#scene_lighting_demo {
    fn main() {
        window {
            width: 800
            height: 600
            title: "3D Lighting Demo"

            class LightScene {
                camera = x3d.camera(
                    position=(2, 2, 6)
                    yaw=200
                    pitch=-5
                    fov=65
                )

                ground = x3d.plane(
                    position=(0, -0.5, 0)
                    size=(8, 1, 8)
                    color=#2A2A3A
                )

                center = x3d.sphere(
                    position=(0, 0.8, 0)
                    size=(1.5, 1.5, 1.5)
                    color=#FF8844
                )

                ring = x3d.torus(
                    position=(0, 1.8, 0)
                    size=(2.2, 0.15, 2.2)
                    color=#44CCFF
                    rotation=30
                )

                pillar_back = x3d.cylinder(
                    position=(0, 0.5, -2.5)
                    size=(0.4, 1.5, 0.4)
                    color=#888888
                )

                left_pillar = x3d.cylinder(
                    position=(-2.5, 0.5, 0)
                    size=(0.4, 1.5, 0.4)
                    color=#888888
                )

                right_pillar = x3d.cylinder(
                    position=(2.5, 0.5, 0)
                    size=(0.4, 1.5, 0.4)
                    color=#888888
                )

                cap_left = x3d.capsule(
                    position=(-2.5, 2.0, 0)
                    size=(0.2, 0.8, 0.2)
                    color=#FFAA44
                )

                cap_right = x3d.capsule(
                    position=(2.5, 2.0, 0)
                    size=(0.2, 0.8, 0.2)
                    color=#FFAA44
                )
            }

            text {
                x: 10
                y: 10
                width: 780
                height: 20
                text: "WASD Move | Lighting Demo - SDF Ray Marched Scene"
            }

            loop {
                speed = 0.1
                if keyboard.w { camera.move.forward(speed) }
                if keyboard.s { camera.move.backward(speed) }
                if keyboard.a { camera.move.left(speed) }
                if keyboard.d { camera.move.right(speed) }
                if keyboard.space { camera.move.up(speed) }
                if keyboard.ctrl { camera.move.down(speed) }
                camera.look(yaw=mouse.dx, pitch=mouse.dy)
            }
        }
    }
}
