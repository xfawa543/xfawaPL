#test_key_click {
    fn main() {
        print("测试key-click触发器")

        window {
            width: 800
            height: 400
            title: "Key Click Test"
            color: white
            style: "test_key_click.xss"

            text {
                x: 10
                y: 10
                text: "Press A key to trigger animation"
            }

            button {
                x: 10
                y: 100
                width: 120
                height: 40
                text: "Animated Button"
                print("Button clicked")
            }
        }
    }
}
