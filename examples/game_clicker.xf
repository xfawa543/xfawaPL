#ClickerGame {
    fn main() {
        window {
            width: 400
            height: 350
            title: "Clicker Game"
            color: lightgreen

            text {
                x: 120
                y: 15
                width: 160
                height: 30
                text: "Click Counter"
            }

            box {
                id: score
                x: 150
                y: 55
                width: 100
                height: 40
                text: "0"
            }

            button {
                x: 100
                y: 110
                width: 200
                height: 60
                text: "CLICK ME!"

                int current = rnd(1, 10)
                print(current, score)
            }

            button {
                x: 50
                y: 190
                width: 130
                height: 45
                text: "Bonus x2"

                int bonus = rnd(2, 5)
                print(bonus, score)
            }

            button {
                x: 220
                y: 190
                width: 130
                height: 45
                text: "Jackpot"

                int jackpot = rnd(10, 50)
                print(jackpot, score)
            }

            box {
                id: message
                x: 50
                y: 260
                width: 300
                height: 50
                text: "Keep clicking!"
            }

            button {
                x: 150
                y: 290
                width: 100
                height: 40
                text: "Reset"

                print("0", score)
                print("Game reset!", message)
            }
        }
    }
}
