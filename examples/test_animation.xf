// Test XSS animation parameters
// This program tests the animation system with visible references

#test_animation {
    fn main() {
        print("Testing XSS Animation Parameters")
        print("================================")

        // Create a window with animated button
        window {
            width: 600
            height: 400
            title: "Animation Test"
            color: white
            style: "animation_test.xss"
            
            // Static reference text (no animation)
            text {
                x: 10
                y: 10
                text: "Reference: Static Text (No Animation)"
            }
            
            // Animated button (will animate on click)
            button {
                x: 10
                y: 80
                width: 100
                height: 40
                text: "Animated Button"
                print("Button with animation clicked!")
            }
            
            // Another static reference below
            text {
                x: 10
                y: 130
                text: "Click anywhere to trigger animation"
            }
            
            // Position reference text
            text {
                x: 200
                y: 10
                text: "x=200"
            }
            
            text {
                x: 10
                y: 150
                text: "y=150"
            }
        }

        print("Animation test completed")
    }
}
