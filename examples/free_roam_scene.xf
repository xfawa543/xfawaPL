#free_roam_scene {
    fn main() {
        window {
            width: 960
            height: 640
            title: "XFAWA 3D Free Roam - WASD+Mouse"

            class World {
                camera = x3d.camera(
                    position=(0, 2, 8)
                    yaw=0
                    pitch=0
                    fov=75
                )

                ground = x3d.plane(
                    position=(0, 0, 0)
                    size=(20, 1, 20)
                    color=#336644
                    rotation=0
                )

                box1 = x3d.box(
                    position=(3, 1, -2)
                    size=(2, 2, 2)
                    color=#FF4444
                    rotation=0
                )

                box2 = x3d.box(
                    position=(-4, 0.75, -3)
                    size=(1.5, 1.5, 1.5)
                    color=#4488FF
                    rotation=30
                )

                sphere1 = x3d.sphere(
                    position=(0, 1.5, -5)
                    size=(2, 2, 2)
                    color=#FFCC00
                    rotation=0
                )

                sphere2 = x3d.sphere(
                    position=(-2, 0.5, 2)
                    size=(1, 1, 1)
                    color=#FF00FF
                    rotation=0
                )

                pillar1 = x3d.cylinder(
                    position=(5, 1.5, -5)
                    size=(0.8, 3, 0.8)
                    color=#FF8800
                    rotation=0
                )

                pillar2 = x3d.cylinder(
                    position=(-5, 1.5, -5)
                    size=(0.8, 3, 0.8)
                    color=#FF8800
                    rotation=0
                )

                pillar3 = x3d.cylinder(
                    position=(5, 1.5, 3)
                    size=(0.8, 3, 0.8)
                    color=#FF8800
                    rotation=0
                )

                pillar4 = x3d.cylinder(
                    position=(-5, 1.5, 3)
                    size=(0.8, 3, 0.8)
                    color=#FF8800
                    rotation=0
                )

                cone1 = x3d.cone(
                    position=(0, 0.5, 3)
                    size=(1.2, 1.5, 1.2)
                    color=#00FF88
                    rotation=0
                )

                torus1 = x3d.torus(
                    position=(3, 2.5, 3)
                    size=(1, 0.3, 1)
                    color=#00FFFF
                    rotation=0
                )

                capsule1 = x3d.capsule(
                    position=(-3, 1, -5)
                    size=(0.5, 2, 0.5)
                    color=#FFFF00
                    rotation=0
                )
            }

            text {
                x: 10
                y: 10
                width: 940
                height: 20
                text: "WASD Move | Mouse Look | Space Up | Ctrl Down | Shift Run"
            }

            loop {
                speed = 0.12
                if keyboard.shift {
                    speed = 0.3
                }

                if keyboard.w {
                    camera.move.forward(speed)
                }
                if keyboard.s {
                    camera.move.backward(speed)
                }
                if keyboard.a {
                    camera.move.left(speed)
                }
                if keyboard.d {
                    camera.move.right(speed)
                }
                if keyboard.space {
                    camera.move.up(speed)
                }
                if keyboard.ctrl {
                    camera.move.down(speed)
                }

                camera.look(
                    yaw = mouse.dx,
                    pitch = mouse.dy
                )
            }
        }
    }
}
