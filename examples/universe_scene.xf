            text {
                x: 10
                y: 10
                width: 940
                height: 20
                text: "深空 - 星空/陨石带/荒凉星球 | WASD移动 鼠标视角 Shift加速"
            }

            loop {
                speed = 0.25
                if keyboard.shift {
                    speed = 0.8
                }
                if keyboard.w {
                    camera.move.forward(speed)
                }
                if keyboard.s {
                    camera.move.backward(speed)
                }
                if keyboard.a {
                    camera.move.left(speed)
                }
                if keyboard.d {
                    camera.move.right(speed)
                }
                if keyboard.space {
                    camera.move.up(speed)
                }
                if keyboard.ctrl {
                    camera.move.down(speed)
                }
                camera.look(
                    yaw = mouse.dx,
                    pitch = mouse.dy
                )
            }
        }
    }
}
